{
  "$schema": "https://unpkg.com/wrangler@4.156.1/config-schema.json",
  "name": "gordianstack-site",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "gordianstack.com", "custom_domain": true },
    { "pattern": "www.gordianstack.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Every request reaches the Worker first, so www can redirect before
  // an asset is served; everything else is handed to the assets binding.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  }
}
